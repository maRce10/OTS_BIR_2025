library(warbleR)
library(warbleR)
ngh_wren <- read_sound_file("https://www.xeno-canto.org/518334/download")
custom_pal <- colorRampPalette( c("#2d2d86", "#2d2d86", reverse.terrain.colors(10)[5:10]))
library(dynaSpec)
scrolling_spectro(
wave = ngh_wren,
wl = 600,
t.display = 3,
ovlp = 95,
pal = custom_pal,
grid = FALSE,
flim = c(1, 8),
width = 700,
height = 3500,
res = 100,
collevels = seq(-40, 0, 5),
file.name = "nightingale_wren.mp4",
colbg = "#2d2d86",
lcol = "#FFFFFFE6"
)
